NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_openai_api_key
# Server-only Runway key used for paid image-to-video jobs.
RUNWAYML_API_SECRET=your_runway_api_secret
# Server-side event relay. The PostHog project key is public by design.
POSTHOG_PROJECT_KEY=phc_your_project_key
# Optional, exam-question narration only. When both are set, exam videos are narrated in this
# ElevenLabs voice (the Indian narrator voice below). When either is missing, FRAME uses its OpenAI
# "cedar" voice. Server-only; the voice ID is not a secret, the API key is.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=MPaTa7NVsOK1Jo2FOqXo
