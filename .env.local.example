NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_openai_api_key
# Server-only Runway key used for paid image-to-video jobs.
RUNWAYML_API_SECRET=your_runway_api_secret
# Server-side event relay. The PostHog project key is public by design.
POSTHOG_PROJECT_KEY=phc_your_project_key
